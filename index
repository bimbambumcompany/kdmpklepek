body{margin:0;background:var(--bg);color:var(--ink);font:500 1.0625rem/1.6 "DM Sans",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.05;margin:0 0 .5em;letter-spacing:-.02em}
h1{font-size:clamp(2.3rem,7vw,4.4rem);font-weight:800}
