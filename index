.soc{display:inline-flex;width:44px;height:44px;border:3px solid var(--line);border-radius:12px;align-items:center;justify-content:center;background:var(--card);color:var(--ink);box-shadow:3px 3px 0 var(--sh);margin:0 10px 10px 0}.soc.off{opacity:.55}
