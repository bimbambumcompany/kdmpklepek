.far{position:absolute;left:-90px;bottom:78px;width:calc(100% + 90px);height:60px;background:radial-gradient(circle at 20px 60px,#58b368 28px,transparent 29px) 0 0/90px 60px repeat-x;animation:mvr 5s linear infinite}
